{
  "env": {
    "node": true,
    "browser": true,
    "es2021": true,
    "jest": true
  },
  "extends": ["eslint:recommended", "prettier"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "globals": {
    "process": "readonly"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-constant-condition": "off",
    "no-empty": "warn"
  },
  "overrides": [
    {
      "files": ["src/ui/app.js"],
      "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "script"
      },
      "rules": {
        "no-func-assign": "off"
      }
    }
  ]
}
